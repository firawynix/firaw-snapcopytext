{
  "name": "firaw-snapcopytext-linux",
  "version": "1.2.0",
  "description": "Captura de tela e OCR local para Linux",
  "main": "main.js",
  "author": { "name": "Firawynix", "email": "88189816+firawynix@users.noreply.github.com" },
  "homepage": "https://github.com/firawynix/firaw-snapcopytext",
  "desktopName": "br.com.firawynix.snapcopytext.desktop",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb --x64"
  },
  "dependencies": { "tesseract.js": "7.0.0" },
  "devDependencies": { "electron": "44.3.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "br.com.firawynix.snapcopytext",
    "productName": "Firaw SnapCopyText",
    "executableName": "firaw-snapcopytext",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "core.js", "index.html", "renderer.js", "styles.css", "node_modules/**/*"],
    "extraResources": [{ "from": "../src/Firaw.SnapCopyText/tessdata", "to": "tessdata", "filter": ["*.traineddata"] }, { "from": "../src/Firaw.SnapCopyText/Assets/firaw-eye.png", "to": "firaw-eye.png" }],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "syncDesktopName": true,
      "icon": "../src/Firaw.SnapCopyText/Assets/firaw-eye.png",
      "artifactName": "Firaw-SnapCopyText-${version}-${arch}.${ext}"
    }
  }
}
