<Window x:Class="Firaw.SnapCopyText.Views.OcrPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - Texto reconhecido" Width="720" Height="520"
        MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Texto reconhecido" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Revise ou corrija o conteúdo antes de copiar. O OCR foi executado localmente."
                       Margin="0,7,0,14" Foreground="{StaticResource FirawMutedText}" />
        </StackPanel>

        <TextBox x:Name="RecognizedText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Padding="14" FontFamily="Consolas" FontSize="15" Background="{StaticResource FirawSurface}"
                 Foreground="{StaticResource FirawText}" BorderBrush="{StaticResource FirawCyan}"
                 BorderThickness="1" SelectionBrush="{StaticResource FirawCyan}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource FirawSecondaryButton}"
                    Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Copiar texto" Style="{StaticResource FirawButton}" Click="CopyButton_Click" />
        </StackPanel>
    </Grid>
</Window>
