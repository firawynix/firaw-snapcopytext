<Window x:Class="Firaw.SnapCopyText.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - SnapCopyText • Editor"
        Width="1180" Height="780" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource FirawText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource FirawSurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2919D3E6" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource FirawCyan}" />
                                <Setter Property="Foreground" Value="{StaticResource FirawCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource FirawText}" />
            <Setter Property="Background" Value="{StaticResource FirawSurfaceRaised}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#344454" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="ToggleButton">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#607080"
                                     StrokeThickness="1" Margin="4" />
                            <Ellipse x:Name="SelectionRing" Stroke="Transparent"
                                     StrokeThickness="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionRing" Property="Stroke" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionRing" Property="Stroke" Value="{StaticResource FirawCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource FirawSurface}" Padding="12,9"
                BorderBrush="#263543" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyTextButton" Style="{StaticResource FirawButton}"
                            Content="Copiar texto" Margin="4,0" Padding="15,8" Click="CopyTextButton_Click" />
                    <ToggleButton x:Name="SelectTextButton" Style="{StaticResource ToolButton}"
                                  Content="Selecionar texto" Margin="4,0" Padding="15,8"
                                  Click="SelectTextButton_Click" />
                    <ToggleButton x:Name="TextHistoryToggle" Style="{StaticResource ToolButton}"
                                  Content="Textos (0)" Margin="4,0" Padding="15,8"
                                  Click="TextHistoryToggle_Click" />
                    <Button x:Name="CopyImageButton" Style="{StaticResource FirawButton}"
                            Content="Copiar imagem" Margin="4,0" Padding="15,8" Click="CopyImageButton_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Content="Salvar PNG" Click="SaveButton_Click" />
                </StackPanel>

                <WrapPanel x:Name="ToolsPanel" VerticalAlignment="Center">
                    <ToggleButton x:Name="SelectTool" Style="{StaticResource ToolButton}" Tag="Select" Content="1 Selecionar" IsChecked="True" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Pencil" Content="2 Caneta" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Arrow" Content="3 Seta" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Rectangle" Content="4 Retângulo" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Highlight" Content="5 Marca-texto" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Text" Content="6 Texto" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Note" Content="7 Anotação" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Redact" Content="8 Censurar" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Blur" Content="9 Borrar" Checked="ToolButton_Checked" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Eraser" Content="0 Borracha" Checked="ToolButton_Checked" />
                    <Button x:Name="AutoBlurButton" Style="{StaticResource SecondaryButton}"
                            Content="Borrar dados sensíveis" ToolTip="Localiza dados sensíveis com OCR local e borra as linhas encontradas"
                            Click="AutoBlurButton_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Tag="Region"
                            Content="+ Região" ToolTip="Adiciona outra região à composição"
                            Click="AddCaptureButton_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Tag="Window"
                            Content="+ Janela" ToolTip="Adiciona outra janela à composição"
                            Click="AddCaptureButton_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Tag="Monitor"
                            Content="+ Monitor" ToolTip="Adiciona outro monitor à composição"
                            Click="AddCaptureButton_Click" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#070A0E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="EditorScrollViewer" Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="28" Focusable="False">
                <Border x:Name="EditorFrame" Background="#111820" BorderBrush="#334555" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="EditorSurface" Background="White">
                        <Canvas x:Name="AnnotationCanvas" Background="Transparent" Cursor="Cross"
                                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                MouseMove="AnnotationCanvas_MouseMove"
                                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp" />
                        <Canvas x:Name="SelectionCanvas" />
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border x:Name="TextHistoryDrawer" Grid.Column="1" Width="350"
                    Visibility="Collapsed" Background="{StaticResource FirawSurface}"
                    BorderBrush="{StaticResource FirawCyan}" BorderThickness="1,0,0,0"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Fechar"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CloseTextHistoryButton_Click" />
                            <TextBlock Text="Textos copiados" FontSize="19"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Use Ctrl ou Shift para selecionar vários textos."
                                   Margin="0,8,0,12" TextWrapping="Wrap"
                                   Foreground="{StaticResource FirawMutedText}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="CopiedTextList" SelectionMode="Extended"
                                 Background="#0C1117" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource FirawText}" />
                                    <Setter Property="Background" Value="{StaticResource FirawSurfaceRaised}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="11,9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource FirawCyan}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource FirawCyan}" />
                                                        <Setter Property="Foreground" Value="#071014" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"
                                                   FontWeight="SemiBold" MaxHeight="58" />
                                        <TextBlock Text="{Binding Details}" Margin="0,5,0,0"
                                                   FontSize="11" Opacity="0.72" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyHistoryText"
                                   Text="Os textos copiados aparecerão aqui enquanto o Firaw estiver ativo."
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource FirawMutedText}"
                                   VerticalAlignment="Center" Margin="24" />
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Copiar selecionados" Style="{StaticResource FirawButton}"
                                Click="CopySelectedHistoryButton_Click" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button Content="Importar atual" Style="{StaticResource SecondaryButton}"
                                    Click="ImportClipboardButton_Click" />
                            <Button Content="Limpar lista" Style="{StaticResource SecondaryButton}"
                                    Click="ClearTextHistoryButton_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource FirawSurface}" Padding="12,8"
                BorderBrush="#263543" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="EditorStatus" DockPanel.Dock="Right" Margin="16,0,0,0"
                           Foreground="{StaticResource FirawMutedText}" VerticalAlignment="Center"
                           Text="Pronto" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource SecondaryButton}" Content="Desfazer" IsEnabled="False" Click="UndoButton_Click" />
                    <Button x:Name="RedoButton" Style="{StaticResource SecondaryButton}" Content="Refazer" IsEnabled="False" Click="RedoButton_Click" />
                    <Separator Margin="8,2" />
                    <TextBlock Text="Cor" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource FirawMutedText}" />
                    <StackPanel x:Name="ColorPalettePanel" Orientation="Horizontal" Margin="0,0,10,0">
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#19D3E6" Background="#19D3E6"
                                      ToolTip="Ciano Firaw" IsChecked="True" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#FF3B5C" Background="#FF3B5C"
                                      ToolTip="Vermelho" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#FFD83D" Background="#FFD83D"
                                      ToolTip="Amarelo" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#35E08D" Background="#35E08D"
                                      ToolTip="Verde" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#4C8DFF" Background="#4C8DFF"
                                      ToolTip="Azul" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#B56CFF" Background="#B56CFF"
                                      ToolTip="Roxo" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#FFFFFF" Background="#FFFFFF"
                                      ToolTip="Branco" Checked="ColorSwatch_Checked" />
                        <ToggleButton Style="{StaticResource ColorSwatch}" Tag="#111111" Background="#111111"
                                      ToolTip="Preto" Checked="ColorSwatch_Checked" />
                    </StackPanel>
                    <TextBlock Text="Espessura" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource FirawMutedText}" />
                    <Slider x:Name="ThicknessSlider" Width="110" Minimum="2" Maximum="16" Value="4"
                            TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <StackPanel x:Name="EraserOptionsPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
                        <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource FirawMutedText}" />
                        <ComboBox x:Name="EraserModeCombo" Width="120" SelectedIndex="0" VerticalAlignment="Center"
                                  SelectionChanged="EraserModeCombo_SelectionChanged">
                            <ComboBoxItem Tag="Object" Content="Objeto inteiro" />
                            <ComboBoxItem Tag="Circle" Content="Circular" />
                            <ComboBoxItem Tag="Square" Content="Quadrada" />
                        </ComboBox>
                        <TextBlock Text="Tamanho" VerticalAlignment="Center" Margin="10,0,6,0"
                                   Foreground="{StaticResource FirawMutedText}" />
                        <Slider x:Name="EraserSizeSlider" Width="90" Minimum="16" Maximum="120" Value="44"
                                TickFrequency="4" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
