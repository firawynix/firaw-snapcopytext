<Window x:Class="Firaw.SnapCopyText.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - SnapCopyText • Editor"
        Width="1180" Height="780" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource FirawText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource FirawSurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2919D3E6" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource FirawCyan}" />
                                <Setter Property="Foreground" Value="{StaticResource FirawCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource FirawText}" />
            <Setter Property="Background" Value="{StaticResource FirawSurfaceRaised}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#344454" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource FirawSurface}" Padding="12,9"
                BorderBrush="#263543" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyTextButton" Style="{StaticResource FirawButton}"
                            Content="Copiar texto" Margin="4,0" Padding="15,8" />
                    <Button x:Name="CopyImageButton" Style="{StaticResource FirawButton}"
                            Content="Copiar imagem" Margin="4,0" Padding="15,8" />
                    <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Content="Salvar PNG" />
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton x:Name="SelectTool" Style="{StaticResource ToolButton}" Tag="Select" Content="Selecionar" IsChecked="True" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Pencil" Content="Caneta" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Arrow" Content="Seta" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Rectangle" Content="Retângulo" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Highlight" Content="Marca-texto" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Text" Content="Texto" />
                    <ToggleButton Style="{StaticResource ToolButton}" Tag="Redact" Content="Censurar" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#070A0E">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="28" Focusable="False">
                <Border Background="#111820" BorderBrush="#334555" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="EditorSurface" Background="White">
                        <Image x:Name="CaptureImage" Stretch="Fill" IsHitTestVisible="False" />
                        <Canvas x:Name="AnnotationCanvas" Background="Transparent" Cursor="Cross" />
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource FirawSurface}" Padding="12,8"
                BorderBrush="#263543" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="EditorStatus" DockPanel.Dock="Right" Margin="16,0,0,0"
                           Foreground="{StaticResource FirawMutedText}" VerticalAlignment="Center"
                           Text="Pronto" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource SecondaryButton}" Content="Desfazer" IsEnabled="False" />
                    <Button x:Name="RedoButton" Style="{StaticResource SecondaryButton}" Content="Refazer" IsEnabled="False" />
                    <Separator Margin="8,2" />
                    <TextBlock Text="Cor" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource FirawMutedText}" />
                    <ComboBox x:Name="ColorPicker" Width="112" SelectedIndex="0" Margin="0,2,10,2">
                        <ComboBoxItem Tag="#19D3E6">Ciano Firaw</ComboBoxItem>
                        <ComboBoxItem Tag="#FF3B5C">Vermelho</ComboBoxItem>
                        <ComboBoxItem Tag="#FFD83D">Amarelo</ComboBoxItem>
                        <ComboBoxItem Tag="#FFFFFF">Branco</ComboBoxItem>
                        <ComboBoxItem Tag="#111111">Preto</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Espessura" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource FirawMutedText}" />
                    <Slider x:Name="ThicknessSlider" Width="110" Minimum="2" Maximum="16" Value="4"
                            TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
