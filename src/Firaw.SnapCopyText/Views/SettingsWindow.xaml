<Window x:Class="Firaw.SnapCopyText.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - Atalhos e preferências"
        Width="490" Height="465" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Atalhos e captura" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Escolha o que o Firaw faz quando você usa o atalho."
                       Margin="0,6,0,0" Foreground="{StaticResource FirawMutedText}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,20">
            <TextBlock Text="Modo padrão do atalho" FontWeight="SemiBold" />
            <ComboBox x:Name="DefaultModeCombo" Height="36" Margin="0,7,0,18"
                      DisplayMemberPath="Label" SelectedValuePath="Value" />

            <TextBlock Text="Atalho personalizado" FontWeight="SemiBold" />
            <TextBox x:Name="ShortcutInput" Height="38" Margin="0,7,0,4"
                     IsReadOnly="True" FontSize="15" VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center" Cursor="Hand"
                     PreviewKeyDown="ShortcutInput_PreviewKeyDown" GotKeyboardFocus="ShortcutInput_GotKeyboardFocus"
                     LostKeyboardFocus="ShortcutInput_LostKeyboardFocus" />
            <TextBlock Text="Clique no campo e pressione a nova combinação."
                       Margin="0,0,0,16" Foreground="{StaticResource FirawMutedText}" FontSize="12" />

            <CheckBox x:Name="UsePrintScreenCheck" Content="Usar também a tecla Print Screen"
                      FontWeight="SemiBold" Foreground="{StaticResource FirawText}" />
            <Border Background="{StaticResource FirawSurfaceRaised}" CornerRadius="8"
                    Padding="12" Margin="0,10,0,0">
                <TextBlock Foreground="{StaticResource FirawMutedText}" TextWrapping="Wrap"
                           Text="Se o Windows mantiver a tecla ocupada, desative a opção ‘Usar Print Screen para abrir a captura de tela’ em Configurações › Acessibilidade › Teclado." />
            </Border>
            <Button Content="Abrir configurações do teclado do Windows"
                    Style="{StaticResource FirawSecondaryButton}" Margin="0,8,0,0"
                    HorizontalAlignment="Left" Click="OpenKeyboardSettingsButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource FirawSecondaryButton}"
                    Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Salvar" Style="{StaticResource FirawButton}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
