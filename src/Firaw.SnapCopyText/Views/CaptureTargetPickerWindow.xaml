<Window x:Class="Firaw.SnapCopyText.Views.CaptureTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - Escolher captura" Width="560" Height="500"
        MinWidth="480" MinHeight="400" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="HelpText" Margin="0,6,0,18"
                       Foreground="{StaticResource FirawMutedText}" />
        </StackPanel>

        <ListBox x:Name="TargetsList" Grid.Row="1" Background="#111820"
                 BorderBrush="#31404D" BorderThickness="1" Padding="6"
                 MouseDoubleClick="TargetsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="13,11" Margin="2" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource FirawText}"
                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Margin="14,0,0,0"
                                       Foreground="{StaticResource FirawCyan}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource FirawSecondaryButton}"
                    Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="CopyButton" Content="Copiar imagem" Margin="0,0,8,0"
                    Style="{StaticResource FirawSecondaryButton}" Click="CopyButton_Click" />
            <Button x:Name="ConfirmButton" Content="Abrir no editor"
                    Style="{StaticResource FirawButton}" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
