<Window x:Class="Firaw.SnapCopyText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw - SnapCopyText"
        Width="560" Height="430"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="0" Background="{StaticResource FirawCyan}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,32,32,0">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="12" Background="#E6071014" Padding="4">
                    <Image Source="/Assets/firaw-eye.png" Stretch="Uniform" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Firaw" FontSize="22" FontWeight="SemiBold" Foreground="#071014" />
                    <TextBlock Text="SnapCopyText" Foreground="#18333C" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Capture, edite e copie textos da tela."
                       FontSize="22" FontWeight="SemiBold" TextAlignment="Center"
                       Foreground="#071014" />
            <TextBlock Text="O processamento é local. Suas capturas não são enviadas para a internet."
                       Margin="24,12,24,24" Foreground="#234C56"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Escolha como capturar" Foreground="#18333C"
                       FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource FirawButton}" Content="Selecionar região" Tag="Region"
                        Background="#151D26" Foreground="{StaticResource FirawCyan}"
                        Margin="4" Click="CaptureModeButton_Click" />
                <Button Style="{StaticResource FirawButton}" Content="Escolher janela" Tag="Window"
                        Background="#151D26" Foreground="{StaticResource FirawCyan}"
                        Margin="4" Click="CaptureModeButton_Click" />
                <Button Style="{StaticResource FirawButton}" Content="Escolher monitor" Tag="Monitor"
                        Background="#151D26" Foreground="{StaticResource FirawCyan}"
                        Margin="4" Click="CaptureModeButton_Click" />
            </StackPanel>
            <Button Style="{StaticResource FirawSecondaryButton}" Content="Atalhos e preferências"
                    Background="#D9101920" Foreground="White" BorderBrush="#253642"
                    Width="190" Margin="0,10,0,0" HorizontalAlignment="Center"
                    Click="SettingsButton_Click" />
            <TextBlock Text="O atalho usa o modo padrão definido nas preferências"
                       Margin="0,14,0,0" Foreground="#234C56"
                       TextAlignment="Center" FontSize="12" />
        </StackPanel>

        <Border Grid.Row="2" Margin="32,0,32,32"
                Background="{StaticResource FirawSurface}" CornerRadius="8" Padding="12,9">
            <TextBlock x:Name="StatusText" Text="Preparando o capturador…"
                       Foreground="{StaticResource FirawMutedText}" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
